{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpenSourceCompliance/oscompliance-core/catalog/schemas/facts/acl_record.v1.json",
  "title": "acl_record v1",
  "description": "Mode, owner and POSIX ACL of one path the manager asked the agent to watch (acl_paths of the shared oscompliance.json). Emitted before the acl_snapshot of the same run_id.",
  "type": "object",
  "required": [
    "path",
    "status"
  ],
  "properties": {
    "fact": {
      "const": "acl_record"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "read",
        "absent",
        "unreadable"
      ]
    },
    "error": {
      "type": "string"
    },
    "mode": {
      "description": "Permission bits in octal, four digits (0750).",
      "type": "string",
      "pattern": "^[0-7]{4}$"
    },
    "owner": {
      "description": "Owner and group names, owner:group; numbers when they have no name.",
      "type": "string"
    },
    "acl": {
      "description": "Extended ACL entries in setfacl short form, sorted: u:name:rwx, g:name:r-x, m::r-x, and d: for default entries. Empty when the path has no extended ACL.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "read"
          }
        }
      },
      "then": {
        "required": [
          "mode",
          "owner",
          "acl"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unreadable"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ],
  "unevaluatedProperties": false
}
