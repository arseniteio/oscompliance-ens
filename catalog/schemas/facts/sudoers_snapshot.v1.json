{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arseniteio/oscompliance-ens/catalog/schemas/facts/sudoers_snapshot.v1.json",
  "title": "sudoers_snapshot v1",
  "description": "Summary of one read of the sudoers policy (/etc/sudoers and the files sudo includes), emitted after its sudo_grant records. blind_spots counts what was read but cannot be attributed to named subjects; while it is not zero, 'nobody else has sudo' cannot be asserted.",
  "type": "object",
  "required": [
    "files",
    "status",
    "blind_spots",
    "records_emitted"
  ],
  "properties": {
    "fact": {
      "const": "sudoers_snapshot"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "read",
              "absent",
              "unreadable"
            ]
          },
          "error": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "description": "read: /etc/sudoers was read; absent: no sudo policy on this host (sudo not installed); unreadable.",
      "enum": [
        "read",
        "absent",
        "unreadable"
      ]
    },
    "blind_spots": {
      "type": "integer",
      "minimum": 0
    },
    "blind_spot_reasons": {
      "description": "Up to 20 short reasons, for the verdict.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaults": {
      "description": "Every Defaults setting, in file order: binding is what follows Defaults (\"\" global, @host, :user, !command, >runas), setting is one entry as written (!authenticate, timestamp_timeout=-1).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "binding",
          "setting",
          "file",
          "line"
        ],
        "additionalProperties": false,
        "properties": {
          "binding": {
            "type": "string"
          },
          "setting": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "records_emitted": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ],
  "unevaluatedProperties": false
}
