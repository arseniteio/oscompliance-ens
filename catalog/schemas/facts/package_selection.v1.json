{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arseniteio/oscompliance-ens/catalog/schemas/facts/package_selection.v1.json",
  "title": "package_selection v1",
  "description": "The packages installed on request (apt-mark showmanual, dnf repoquery --userinstalled), not the dependencies they pulled in.",
  "type": "object",
  "required": [
    "manager",
    "status",
    "packages"
  ],
  "properties": {
    "fact": {
      "const": "package_selection"
    },
    "manager": {
      "enum": [
        "apt",
        "dnf",
        "none"
      ]
    },
    "status": {
      "enum": [
        "read",
        "error"
      ]
    },
    "error": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ]
}
