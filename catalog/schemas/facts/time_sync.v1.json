{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arseniteio/oscompliance-ens-wazuh/catalog/schemas/facts/time_sync.v1.json",
  "title": "time_sync v1",
  "description": "How the machine keeps its clock: chrony or systemd-timesyncd, whether it is synchronised, its offset, the sources in use and whether they are authenticated.",
  "type": "object",
  "required": [
    "tool",
    "status",
    "synchronised",
    "offset_seconds",
    "sources",
    "authenticated"
  ],
  "properties": {
    "fact": {
      "const": "time_sync"
    },
    "tool": {
      "enum": [
        "chrony",
        "timesyncd",
        "none"
      ]
    },
    "status": {
      "enum": [
        "read",
        "error"
      ]
    },
    "error": {
      "type": "string"
    },
    "synchronised": {
      "type": "boolean"
    },
    "offset_seconds": {
      "type": "number"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authenticated": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ]
}
