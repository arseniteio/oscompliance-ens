{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpenSourceCompliance/oscompliance-ens/catalog/schemas/facts/wazuh_agent_config.v1.json",
  "title": "wazuh_agent_config v1",
  "description": "What the Wazuh agent of the machine is configured to watch, from its ossec.conf and the shared agent.conf blocks that apply to it: the FIM directories and the log files it reads. The engine checks with it that a silence of Wazuh is a real silence.",
  "type": "object",
  "required": [
    "status",
    "syscheck_disabled",
    "directories",
    "localfiles",
    "syscollector_disabled",
    "syscollector_scans",
    "sca_disabled",
    "syscheck_scan_on_start",
    "rootcheck_disabled",
    "integrations",
    "active_responses",
    "sealed_days",
    "lists"
  ],
  "properties": {
    "fact": {
      "const": "wazuh_agent_config"
    },
    "status": {
      "description": "read; absent (no Wazuh agent installed); unreadable.",
      "enum": [
        "read",
        "absent",
        "unreadable"
      ]
    },
    "error": {
      "type": "string"
    },
    "syscheck_disabled": {
      "description": "FIM is switched off (<disabled>yes</disabled>).",
      "type": "boolean"
    },
    "syscheck_frequency": {
      "description": "Seconds between scheduled FIM scans.",
      "type": "integer",
      "minimum": 0
    },
    "directories": {
      "description": "FIM <directories>, one entry per path.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "realtime": {
            "type": "boolean"
          },
          "whodata": {
            "type": "boolean"
          },
          "source": {
            "description": "ossec.conf or the shared agent.conf.",
            "type": "string"
          }
        }
      }
    },
    "ignored": {
      "description": "FIM <ignore> entries.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "localfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "location",
          "format"
        ],
        "additionalProperties": false,
        "properties": {
          "location": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "syscollector_disabled": {
      "description": "No syscollector wodle, or <disabled>yes</disabled>.",
      "type": "boolean"
    },
    "syscollector_interval": {
      "description": "Seconds between syscollector scans.",
      "type": "integer",
      "minimum": 1
    },
    "syscollector_scans": {
      "description": "Syscollector scans switched on.",
      "type": "array",
      "items": {
        "enum": [
          "hardware",
          "os",
          "network",
          "packages",
          "ports",
          "processes"
        ]
      }
    },
    "sca_disabled": {
      "description": "No <sca> block, or <enabled>no</enabled>.",
      "type": "boolean"
    },
    "sca_interval": {
      "description": "Seconds between SCA assessments.",
      "type": "integer",
      "minimum": 1
    },
    "syscheck_scan_on_start": {
      "description": "FIM scans when the agent starts (Wazuh's default).",
      "type": "boolean"
    },
    "rootcheck_disabled": {
      "type": "boolean"
    },
    "integrations": {
      "description": "<integration> names of this ossec.conf (on the manager: virustotal, slack...).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active_responses": {
      "description": "Active response scripts the manager sends to this machine (shared/ar.conf), restarts left out.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sealed_days": {
      "description": "Days (YYYY-MM-DD) of the last 400 whose alert log is signed (.log.sum). Empty off the manager.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lists": {
      "description": "CDB lists of etc/lists. Empty off the manager.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "modified"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "modified": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unreadable"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ],
  "unevaluatedProperties": false
}
