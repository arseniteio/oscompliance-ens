{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arseniteio/oscompliance-ens/catalog/schemas/facts/transaction_snapshot.v1.json",
  "title": "transaction_snapshot v1",
  "description": "The read of apt history behind the package_transaction records of a pass.",
  "type": "object",
  "required": [
    "manager",
    "status",
    "records_emitted"
  ],
  "properties": {
    "fact": {
      "const": "transaction_snapshot"
    },
    "manager": {
      "enum": [
        "apt",
        "none"
      ]
    },
    "status": {
      "enum": [
        "read",
        "absent",
        "unreadable"
      ]
    },
    "error": {
      "type": "string"
    },
    "records_emitted": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ]
}
