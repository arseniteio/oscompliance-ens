{
  "role": "oscompliance_engine",
  "policy": {
    "name": "oscompliance_engine_groups",
    "policy": {
      "actions": ["group:read", "group:update_config", "agent:read", "syscollector:read", "manager:read", "rules:read"],
      "resources": ["group:id:*", "agent:id:*", "agent:group:*", "*:*:*", "rule:file:*"],
      "effect": "allow"
    }
  }
}
