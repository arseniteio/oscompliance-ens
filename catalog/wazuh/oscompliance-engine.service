[Unit]
Description=OSCompliance ENS engine
After=network-online.target wazuh-indexer.service wazuh-manager.service
Wants=network-online.target

[Service]
Environment=OSC_INDEXER_URLS=https://127.0.0.1:9200 OSC_INDEXER_CA=/etc/wazuh-indexer/certs/root-ca.pem
EnvironmentFile=-/etc/oscompliance/engine.conf
EnvironmentFile=/etc/oscompliance/engine.env
ExecStart=/usr/local/bin/oscompliance-engine \
  -indexer=${OSC_INDEXER_URLS} -user=oscompliance \
  -ca=${OSC_INDEXER_CA} \
  -wazuh-api=https://127.0.0.1:55000 -wazuh-api-user=oscompliance \
  -wazuh-api-ca=/var/ossec/api/configuration/ssl/server.crt -wazuh-api-server-name=localhost \
  -interval=15m -sync-apply
Restart=on-failure
RestartSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
